# =============================================================================
# Customer Care Monitor AI - Biến môi trường
# =============================================================================
# Sao chép file này thành .env và điền thông tin phù hợp:
#   cp .env.example .env

# --- Server ---
COMPOSE_PROJECT_NAME=ccma
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
APP_ENV=production
# APP_URL=https://care.example.com  # URL công khai (dùng cho links trong notification)

# --- Database (MySQL 8+) ---
DB_HOST=db
DB_PORT=3306
DB_USER=ccma
DB_PASSWORD=       # Bắt buộc — mật khẩu MySQL cho user ccma
DB_NAME=CCMA
MYSQL_ROOT_PASSWORD=  # Bắt buộc — mật khẩu root MySQL

# Cổng host cho bản cài đặt này. Đổi thành 80/443 khi cấp chứng chỉ Let's Encrypt.
HTTP_PORT=8088
HTTPS_PORT=8443

# --- Bảo mật (BẮT BUỘC — tạo giá trị ngẫu nhiên cho production) ---
# JWT_SECRET: chuỗi ngẫu nhiên, tối thiểu 32 ký tự
#   Tạo: openssl rand -hex 32
JWT_SECRET=

# ENCRYPTION_KEY: đúng 32 bytes cho AES-256-GCM
#   Tạo: openssl rand -hex 16
ENCRYPTION_KEY=

# Chỉ bật khi chủ động cho phép tải bảng giá model từ nguồn HTTPS công khai.
PRICING_SYNC_ENABLED=false

# --- Rate Limiting (mỗi phút) ---
RATE_LIMIT_PER_IP=500
RATE_LIMIT_PER_USER=1000

# --- SSL (tùy chọn — để trống nếu dùng HTTP) ---
# Đặt domain để tự động tạo và gia hạn SSL qua Let's Encrypt
# LEGO_DOMAIN=care.example.com
# LEGO_EMAIL=admin@example.com
