#!/bin/sh
# CVF downstream pre-commit preflight template (cvf.downstreamGateProfile@1.1.0).
# Copy to .git/hooks/pre-commit to activate it. Installing this template does not
# activate it: the coverage readout reports it as INSTALLED only, never as invoked.
set -e
export PYTHONDONTWRITEBYTECODE=1
exec python scripts/cvf_gates/cvf_downstream_gate_runner.py run --phase pre-commit --project-root .
